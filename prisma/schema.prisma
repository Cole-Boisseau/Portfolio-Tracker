generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  lots          PositionLot[]
  watchlist     WatchlistItem[]
  settings      AppSetting[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PositionLot {
  id            String   @id @default(cuid())
  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetType     String   @default("stock")
  assetId       String?
  ticker        String
  shares        Float
  purchasePrice Float
  purchaseDate  DateTime
  notes         String?
  splitFactor   Float    @default(1)
  splitDetailsJson String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ticker])
  @@index([assetType, assetId])
  @@index([userId, assetType, assetId])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetType String   @default("stock")
  assetId   String?
  assetKey  String
  ticker    String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, assetKey])
}

model CryptoCache {
  id              String   @id
  ticker          String
  companyName     String
  imageUrl        String?
  currentPrice    Float?
  previousClose   Float?
  dailyChange     Float?
  dailyPercent    Float?
  marketTime      DateTime?
  profileJson     String?
  chartJson       String?
  quoteUpdatedAt  DateTime?
  chartUpdatedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ticker])
}

model StockCache {
  ticker         String   @id
  companyName    String?
  currentPrice   Float?
  previousClose  Float?
  dailyChange    Float?
  dailyPercent   Float?
  marketTime     DateTime?
  profileJson    String?
  chartJson      String?
  newsJson       String?
  splitsJson     String?
  quoteUpdatedAt DateTime?
  newsUpdatedAt  DateTime?
  splitsUpdatedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AppSetting {
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}
