# Neon pooled connection for application queries, direct connection for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-HOST-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-HOST.neon.tech/neondb?sslmode=require"

# GitHub OAuth application (different credentials from your GitHub login).
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Set only behind a trusted proxy such as Vercel or Codespaces.
AUTH_TRUST_HOST="true"
# Leave AUTH_URL unset on Vercel. For local development you may set it to http://localhost:3000.

# Polygon is the default live market-data provider.
# Keep this server-side only. Never prefix it with NEXT_PUBLIC_.
POLYGON_API_KEY="your_api_key_here"

# Free CoinGecko Demo key for crypto prices, 24-hour trends, and history.
# Keep this server-side only. Never prefix it with NEXT_PUBLIC_.
COINGECKO_API_KEY="your_coingecko_demo_key_here"

# Optional: set MARKET_PROVIDER="demo" for offline demo data or "finnhub" for the legacy provider.
MARKET_PROVIDER="polygon"
FINNHUB_API_KEY=""

# Cache quotes locally to reduce free-tier usage. Default refresh window is 30 minutes.
MARKET_CACHE_SECONDS="1800"
MARKET_NEWS_CACHE_SECONDS="21600"

# Company and ticker metadata changes rarely, so searches can be cached for one day.
MARKET_SEARCH_CACHE_SECONDS="86400"
MARKET_SPLIT_CACHE_SECONDS="86400"
CRYPTO_CACHE_SECONDS="1800"
CRYPTO_CHART_CACHE_SECONDS="21600"
CRYPTO_SEARCH_CACHE_SECONDS="86400"

# Daily central-bank exchange rates are cached for 12 hours.
FX_CACHE_SECONDS="43200"
